<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Blobatar</RootNamespace>
    <AssemblyName>Blobatar</AssemblyName>
    <PackageId>Blobatar</PackageId>
    <Title>Blobatar</Title>
    <Description>Deterministic geometric avatars ("blobatars") from any string, rendered as SVG. A faithful C# port of blobatar (blobatar.dev) whose output is byte-identical to the original library, with no dependencies.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blobatar.Tests" />
  </ItemGroup>

</Project>
